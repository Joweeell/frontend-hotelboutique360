# ---------------------------------------------------------------------------
# Plantilla de variables del frontend. Copiar a .env y ajustar si cambia el valor.
# Debe quedar IGUAL que el .env real: es la fuente de verdad del stack.
# ---------------------------------------------------------------------------

# Cognito (obligatorio): authority del pool y client id de la app SPA.
VITE_COGNITO_AUTHORITY=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_rf0QM9OSc
VITE_COGNITO_CLIENT_ID=6kedlgs87lqop67oboc65h7lh7

# URL del API Gateway (produccion). El frontend llama a /api/... sobre este dominio.
VITE_API_URL=https://evyja84d54.execute-api.us-east-1.amazonaws.com

# Base de las llamadas a la API:
#   - '' (vacio) -> mismo origen. En local lo resuelve el proxy de Vite; en AWS, CloudFront.
#   - URL del API Gateway -> cuando el front se sirve desde S3 y la API esta en otro dominio.
# En produccion va la URL del API Gateway (igual que VITE_API_URL).
VITE_API_BASE=https://evyja84d54.execute-api.us-east-1.amazonaws.com
